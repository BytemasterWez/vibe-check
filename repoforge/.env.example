# RepoForge configuration. Copy to .env and fill in. NEVER commit .env.
REPOFORGE_MODE=local_ai
REPOFORGE_DATA_DIR=/Volumes/RepoForge/repoforge-data
REPOFORGE_PORT=18765

# GitHub — read-only token for public repo metadata.
GITHUB_TOKEN=
GITHUB_API_BUDGET_PER_HOUR=1000
GITHUB_MAX_CONCURRENCY=3

# Ollama runs natively on macOS; the container reaches it via host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Choose models AFTER checking `ollama list`. Do not auto-pull huge models.
OLLAMA_CLASSIFIER_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Telegram (optional). Both must be set for alerts to send.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin token protects mutation endpoints. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# PostgreSQL. Password is required.
POSTGRES_USER=repoforge
POSTGRES_PASSWORD=
POSTGRES_DB=repoforge

# Scheduling / ops.
DAILY_REPORT_TIME=08:00
TIMEZONE=Europe/London
BACKUP_RETENTION_DAYS=14
MIN_FREE_DISK_GB=25
LOG_LEVEL=INFO
