# --- Postgres ---
POSTGRES_USER=countysignal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=countysignal
CSE_DATABASE_URL=postgresql+psycopg2://countysignal:change-me@postgres-postgis:5432/countysignal
# Read-only role used by the API service (created by migration 0012)
CSE_API_DATABASE_URL=postgresql+psycopg2://countysignal_api_ro:change-me-ro@postgres-postgis:5432/countysignal
CSE_API_RO_PASSWORD=change-me-ro

# --- Redis (job state, cache, rate limiting) ---
CSE_REDIS_URL=redis://redis:6379/0

# --- Object storage (raw artifacts) ---
CSE_OBJECT_STORE=s3
CSE_S3_ENDPOINT=http://object-storage:9000
CSE_S3_BUCKET=cse-raw
CSE_S3_ACCESS_KEY=minioadmin
CSE_S3_SECRET_KEY=change-me
# Local fallback when CSE_OBJECT_STORE=local
CSE_RAW_DIR=/data/raw

# --- API ---
CSE_API_KEYS=dev-key-change-me            # comma-separated valid API keys
CSE_RATE_LIMIT_PER_MINUTE=120
CSE_API_HOST=0.0.0.0
CSE_API_PORT=8000

# --- Upstream API keys (only where the contract requires one) ---
CENSUS_API_KEY=                            # optional; raises Census rate limits
BLS_API_KEY=                               # optional; only needed for API access method
