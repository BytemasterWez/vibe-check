# CableLight BedSense V0 — example environment configuration
# Non-clinical research demonstrator. Local-only. No cloud, camera or microphone.

DATABASE_URL=postgresql://bedsense:bedsense@localhost:5438/bedsense
LOCAL_ONLY=true
ENABLE_MOCK_SENSOR=true
ENABLE_AI_EXPLANATIONS=false

# Fusion / detection tuning
FUSION_INTERVAL_SECONDS=1
BREATHING_LIKE_THRESHOLD=0.60
OCCUPANCY_THRESHOLD=0.65
BED_EXIT_CONFIRMATION_SECONDS=15

# Export locations (inside the api container these map to ./evidence and ./data)
EVIDENCE_DIR=./evidence
DATA_DIR=./data
