{
  "capability_id": "source.usaspending.toptier_agencies",
  "manifest_version": "1.0",
  "claim": "Returns all top-tier US federal agencies with budgetary resources from the USAspending API, no authentication required",
  "publisher": {
    "name": "US Department of the Treasury (USAspending)",
    "authority_url": "https://api.usaspending.gov/"
  },
  "protocol": "rest",
  "category": "government",
  "tags": [
    "spending",
    "budget",
    "federal",
    "agencies",
    "procurement",
    "government",
    "united-states"
  ],
  "tasks": [
    "list federal agencies with budget data",
    "federal spending and award records",
    "government procurement data"
  ],
  "coverage": {
    "countries": [
      "US"
    ],
    "granularity": "agency; deeper endpoints cover awards and transactions",
    "temporal": "fiscal year 2001 to present"
  },
  "join_keys": [
    "toptier_code",
    "agency_id"
  ],
  "update_frequency": "nightly",
  "license": "Public domain (US federal data)",
  "auth": {
    "type": "none",
    "paid": false
  },
  "cost": {
    "per_call_usd": 0
  },
  "rate_limit": "unpublished",
  "pagination": "endpoint-specific; this reference endpoint returns all rows",
  "risk_class": "read_only",
  "receipt_ttl_hours": 24,
  "endpoint": {
    "method": "GET",
    "url": "https://api.usaspending.gov/api/v2/references/toptier_agencies/"
  },
  "usage_notes": "Reference endpoint for joining spending data; award search endpoints are POST with JSON filters.",
  "test_pack": {
    "id": "usaspending_agencies_v1",
    "request": {
      "method": "GET",
      "url": "https://api.usaspending.gov/api/v2/references/toptier_agencies/"
    },
    "checks": [
      {
        "type": "status",
        "equals": 200
      },
      {
        "type": "json"
      },
      {
        "type": "max_latency",
        "ms": 15000
      },
      {
        "type": "min_rows",
        "path": "results",
        "min": 90
      },
      {
        "type": "fields_present",
        "path": "results",
        "fields": [
          "agency_id",
          "toptier_code",
          "agency_name",
          "active_fy"
        ]
      },
      {
        "type": "field_pattern",
        "path": "results",
        "field": "toptier_code",
        "pattern": "^[0-9]{3,4}$"
      }
    ],
    "contract_version": "1.0.0"
  },
  "fallback_capability_ids": []
}
