{
  "capability_id": "source.zippopotam.zip_lookup",
  "manifest_version": "1.0",
  "claim": "Resolves a US ZIP code to place name, state and coordinates, no authentication required",
  "publisher": {
    "name": "Zippopotam.us",
    "authority_url": "https://www.zippopotam.us/"
  },
  "protocol": "rest",
  "category": "geospatial",
  "tags": ["zip", "postal-code", "geocode", "place", "lookup", "united-states"],
  "tasks": [
    "convert ZIP code to city and state",
    "get coordinates for a postal code",
    "postal code lookup for 60+ countries"
  ],
  "coverage": {
    "countries": ["US", "global"],
    "granularity": "postal code",
    "temporal": "static reference data"
  },
  "join_keys": ["post_code", "state_abbreviation"],
  "update_frequency": "static reference dataset",
  "license": "Free service, GeoNames-derived data (CC BY)",
  "auth": { "type": "none", "paid": false },
  "cost": { "per_call_usd": 0 },
  "rate_limit": "fair use",
  "pagination": "none",
  "risk_class": "read_only",
  "receipt_ttl_hours": 24,
  "endpoint": {
    "method": "GET",
    "url": "https://api.zippopotam.us/us/{zip}"
  },
  "usage_notes": "Field names contain spaces (e.g. \"place name\", \"state abbreviation\"). Unknown ZIPs return 404 with an empty body.",
  "test_pack": {
    "id": "zippopotam_90210_v1",
    "request": {
      "method": "GET",
      "url": "https://api.zippopotam.us/us/90210"
    },
    "checks": [
      { "type": "status", "equals": 200 },
      { "type": "json" },
      { "type": "max_latency", "ms": 10000 },
      { "type": "known_answer", "path": "post code", "equals": "90210" },
      { "type": "min_rows", "path": "places", "min": 1 },
      { "type": "known_answer", "path": "places.0.state abbreviation", "equals": "CA" },
      { "type": "field_pattern", "path": "places", "field": "latitude", "pattern": "^-?[0-9]+\\.[0-9]+$" }
    ]
  },
  "fallback_capability_ids": ["source.fcc.census_area_lookup"]
}
