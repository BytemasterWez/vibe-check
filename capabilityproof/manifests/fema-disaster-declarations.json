{
  "capability_id": "source.fema.disaster_declarations",
  "manifest_version": "1.0",
  "claim": "Returns US federal disaster declaration summaries by state and date from the OpenFEMA API, no authentication required",
  "publisher": {
    "name": "FEMA",
    "authority_url": "https://www.fema.gov/about/openfema/data-sets"
  },
  "protocol": "rest",
  "category": "hazards",
  "tags": [
    "disaster",
    "fema",
    "declarations",
    "hazard",
    "emergency",
    "united-states",
    "state"
  ],
  "tasks": [
    "list federal disaster declarations",
    "disaster history by US state",
    "emergency declaration records"
  ],
  "coverage": {
    "countries": [
      "US"
    ],
    "granularity": "state and county (designated areas)",
    "temporal": "1953 to present"
  },
  "join_keys": [
    "state",
    "fips_state_code",
    "declaration_date"
  ],
  "update_frequency": "daily",
  "license": "Public domain (US federal data)",
  "auth": {
    "type": "none",
    "paid": false
  },
  "cost": {
    "per_call_usd": 0
  },
  "rate_limit": "unpublished; OData-style paging",
  "pagination": "$top/$skip OData parameters, metadata.count for totals",
  "risk_class": "read_only",
  "receipt_ttl_hours": 24,
  "endpoint": {
    "method": "GET",
    "url": "https://www.fema.gov/api/open/v2/DisasterDeclarationsSummaries?$top={n}&$skip={offset}"
  },
  "usage_notes": "OData-ish API: filter with $filter, page with $top/$skip. metadata.rundate shows dataset build time.",
  "test_pack": {
    "id": "fema_declarations_v1",
    "request": {
      "method": "GET",
      "url": "https://www.fema.gov/api/open/v2/DisasterDeclarationsSummaries?$top=25"
    },
    "checks": [
      {
        "type": "status",
        "equals": 200
      },
      {
        "type": "json"
      },
      {
        "type": "max_latency",
        "ms": 15000
      },
      {
        "type": "min_rows",
        "path": "DisasterDeclarationsSummaries",
        "min": 25
      },
      {
        "type": "fields_present",
        "path": "DisasterDeclarationsSummaries",
        "fields": [
          "femaDeclarationString",
          "state",
          "declarationDate",
          "incidentType"
        ]
      },
      {
        "type": "field_pattern",
        "path": "DisasterDeclarationsSummaries",
        "field": "state",
        "pattern": "^[A-Z]{2}$"
      },
      {
        "type": "freshness",
        "path": "metadata.rundate",
        "max_age_hours": 72
      }
    ],
    "contract_version": "1.0.0"
  },
  "fallback_capability_ids": []
}
